// 一般用 setup-signing.sh 自动生成 Local.xcconfig；脚本读不到 Team ID 时才复制本文件手写。
// Local.xcconfig 已被 .gitignore 忽略。只在真机安装时需要，只跑模拟器可以不建。

// 个人 Team 的 ID（10 位字母数字）：在终端运行
// defaults read com.apple.dt.Xcode IDEProvisioningTeamByIdentifier，看其中的 teamID
DEVELOPMENT_TEAM = ABCDE12345

// 以点开头，只用小写字母和数字，例如 .wensharre
BUNDLE_ID_SUFFIX = .yourname
