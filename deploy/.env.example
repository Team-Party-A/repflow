# Copy to .env on the server; fill values interactively. Never commit .env.
API_IMAGE=ghcr.io/team-party-a/repflow-api@sha256:REPLACE_WITH_CI_DIGEST
POSTGRES_DB=repflow
POSTGRES_USER=repflow
POSTGRES_PASSWORD=
HTTP_PORT=8080
# 备用配置 compose.ghcr.yaml 使用；仅填写 CI 输出的 GHCR 摘要。
NGINX_IMAGE=
POSTGRES_IMAGE=
# HTTPS 的 GHCR 备用镜像：填写 Backup mirror index 实际输出的摘要。
CERTBOT_IMAGE=

# 可选饮食识别配置；留空时仍可手动记餐。填入实际模型/接入点及每百万 token 人民币费率。
ARK_API_KEY=
ARK_VISION_MODEL=
ARK_TEXT_MODEL=
ARK_VISION_INPUT_CNY_PER_MTOK=
ARK_VISION_CACHED_INPUT_CNY_PER_MTOK=
ARK_VISION_OUTPUT_CNY_PER_MTOK=
ARK_TEXT_INPUT_CNY_PER_MTOK=
ARK_TEXT_CACHED_INPUT_CNY_PER_MTOK=
ARK_TEXT_OUTPUT_CNY_PER_MTOK=
NUTRITION_DAILY_LIMIT=100
NUTRITION_USER_DAILY_LIMIT=20
NUTRITION_ACTIVE_LIMIT=4
